    "typecheck": "vue-tsc --build --noEmit"
  },
  "dependencies": {
    "@noble/hashes": "2.4.0",
    "archiver": "^7.0.1",
    "cheerio": "^1.2.0",
    "hash-wasm": "4.12.0",
    "nuxt": "^4.5.2",
    "uqr": "^0.1.3",
    "vue": "^3.5.42",
    "vue-router": "^5.3.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/archiver": "7.0.0",
    "@types/node": "^22.20.4",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-vue": "10.11.1",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vue-eslint-parser": "10.3.0",
    "vue-tsc": "3.3.13"
  }
